# Configuration reference only; Node does not load this file automatically.
NODE_ENV=production
# DATABASE_URL selects PostgreSQL; keep credentials only in protected settings.
DATABASE_URL=
DATABASE_SSL=false
VETASTART_PG_SCHEMA=vetastart_pilot
VETASTART_PUBLIC_ORIGIN=https://vetastart-app-2026.onrender.com
VETASTART_DB_PATH=/var/data/vetastart.sqlite
VETASTART_PERSISTENT_DATA_DIR=/var/data
VETASTART_READINESS_PROFILE=runtime
VETASTART_SIGNUP_ENABLED=false
VETASTART_AUTH_DEV_MODE=false
VETASTART_AUTOMATION_ENABLED=false
VETASTART_AUTOMATION_INTERVAL_MS=10000
VETASTART_SEND_ENABLED=false

INSTAGRAM_LOGIN_MODE=unified
META_APP_ID=1810672910147174
META_GRAPH_API_VERSION=v27.0
INSTAGRAM_CONFIG_ID=1674463687685006
INSTAGRAM_REDIRECT_URI=https://vetastart-app-2026.onrender.com/auth/instagram/callback
META_CLIENT_BUSINESS_ID=
META_SUAT_NON_EXPIRING=false
META_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
VETASTART_ADMIN_TOKEN=
VETASTART_TOKEN_KEY=

VETASTART_MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

ROBOKASSA_ENABLED=false
ROBOKASSA_TEST_MODE=true
ROBOKASSA_LIVE_ENABLED=false
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_HASH_ALGORITHM=
ROBOKASSA_TEST_PASSWORD1=
ROBOKASSA_TEST_PASSWORD2=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
